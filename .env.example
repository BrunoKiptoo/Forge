NODE_ENV=development

# API
PORT=3001

# MongoDB
MONGODB_URI=mongodb://admin:password@localhost:27017/forge?authSource=admin

# Auth
JWT_SECRET=supersecret-jwt-key-change-me-production-32chars
JWT_REFRESH_SECRET=supersecret-refresh-key-change-me-production

# GitHub OAuth (optional - leave blank to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# AI Provider (deepseek | openai | anthropic | gemini | grok)
AI_PROVIDER=deepseek
AI_PROVIDER_API_KEY=sk-your-deepseek-api-key
AI_PROVIDER_BASE_URL=https://api.deepseek.com
AI_PROVIDER_MODEL=deepseek-chat
